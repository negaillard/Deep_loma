@page
@model AdminApp.Pages.Users.IndexModel
@using Models
@{
    ViewData["Title"] = "Пользователи";
}

<!-- Notifications -->
@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success d-flex align-items-center gap-2 mb-3 py-2" role="alert">
        <i class="bi bi-check-circle-fill flex-shrink-0"></i>
        <span>@success</span>
    </div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger d-flex align-items-center gap-2 mb-3 py-2" role="alert">
        <i class="bi bi-exclamation-circle-fill flex-shrink-0"></i>
        <span>@error</span>
    </div>
}

<div class="row g-4">

    <!-- Create form -->
    <div class="col-xl-4">
        <div class="card">
            <div class="card-header" data-bs-toggle="collapse" data-bs-target="#createForm"
                 style="cursor:pointer;">
                <span><i class="bi bi-person-plus me-2"></i>Новый пользователь</span>
                <i class="bi bi-chevron-down ms-auto float-end" style="font-size:0.8rem; color:#9ca3af;"></i>
            </div>
            <div class="collapse show" id="createForm">
                <div class="card-body">
                    <form method="post" asp-page-handler="Create">
                        <div class="mb-2">
                            <label asp-for="NewUser.Fullname" class="form-label" style="font-size:0.82rem;font-weight:600;color:#374151;">
                                ФИО <span class="text-danger">*</span>
                            </label>
                            <input asp-for="NewUser.Fullname" class="form-control form-control-sm"
                                   placeholder="Иванов Иван Иванович" />
                            <span asp-validation-for="NewUser.Fullname" class="text-danger" style="font-size:0.78rem;"></span>
                        </div>

                        <div class="mb-2">
                            <label asp-for="NewUser.Login" class="form-label" style="font-size:0.82rem;font-weight:600;color:#374151;">
                                Логин <span class="text-danger">*</span>
                            </label>
                            <input asp-for="NewUser.Login" class="form-control form-control-sm"
                                   placeholder="ivanov" autocomplete="off" />
                            <span asp-validation-for="NewUser.Login" class="text-danger" style="font-size:0.78rem;"></span>
                        </div>

                        <div class="mb-2">
                            <label asp-for="NewUser.Email" class="form-label" style="font-size:0.82rem;font-weight:600;color:#374151;">
                                Email <span class="text-danger">*</span>
                            </label>
                            <input asp-for="NewUser.Email" class="form-control form-control-sm"
                                   placeholder="ivanov@company.ru" type="email" />
                            <span asp-validation-for="NewUser.Email" class="text-danger" style="font-size:0.78rem;"></span>
                        </div>

                        <div class="mb-2">
                            <label asp-for="NewUser.SystemRole" class="form-label" style="font-size:0.82rem;font-weight:600;color:#374151;">
                                Системная роль
                            </label>
                            <select asp-for="NewUser.SystemRole" class="form-select form-select-sm">
                                <option value="@SystemRole.DocumentManager">Менеджер документов</option>
                                <option value="@SystemRole.Signer">Подписант</option>
                                <option value="@SystemRole.SystemAdmin">Системный администратор</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewUser.RoleId" class="form-label" style="font-size:0.82rem;font-weight:600;color:#374151;">
                                Роль (подразделение)
                            </label>
                            <select asp-for="NewUser.RoleId" asp-items="Model.RoleSelectList"
                                    class="form-select form-select-sm"></select>
                        </div>

                        <button type="submit" class="btn btn-primary btn-sm w-100">
                            <i class="bi bi-person-plus me-1"></i>Создать пользователя
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Users list -->
    <div class="col-xl-8">
        <div class="card">
            <div class="card-header d-flex align-items-center gap-3 flex-wrap">
                <span><i class="bi bi-people me-2"></i>Список пользователей</span>

                <!-- Search -->
                <form method="post" asp-page-handler="Search" class="d-flex gap-2 ms-auto">
                    <div class="input-group input-group-sm" style="max-width: 280px;">
                        <input type="text" name="search" value="@Model.SearchTerm"
                               class="form-control" placeholder="Поиск по имени..." />
                        <button type="submit" class="btn btn-outline-secondary">
                            <i class="bi bi-search"></i>
                        </button>
                        @if (Model.IsSearchActive)
                        {
                            <a asp-page="/Users/Index" class="btn btn-outline-danger" title="Очистить">
                                <i class="bi bi-x"></i>
                            </a>
                        }
                    </div>
                </form>
            </div>

            @if (Model.IsSearchActive)
            {
                <div class="px-3 py-2" style="background:#f0f7ff; border-bottom:1px solid #e8ecf0;">
                    <small style="color:#1e40af;">
                        <i class="bi bi-search me-1"></i>
                        Результаты поиска по: <strong>«@Model.SearchTerm»</strong>
                        — найдено: @Model.Users.Count
                    </small>
                </div>
            }

            @if (Model.Users.Count == 0)
            {
                <div class="card-body text-center py-5">
                    <i class="bi bi-inbox" style="font-size: 2.5rem; color: #d1d5db;"></i>
                    <p class="mt-2 mb-0" style="color: #9ca3af; font-size: 0.875rem;">
                        @(Model.IsSearchActive ? "Ничего не найдено" : "Пользователи не найдены")
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th style="width:45px;">#</th>
                                <th>ФИО</th>
                                <th>Логин</th>
                                <th>Email</th>
                                <th>Системная роль</th>
                                <th>Статус</th>
                                <th>Создан</th>
                                <th style="width:80px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.Users)
                            {
                                <tr>
                                    <td>
                                        <span style="font-size:0.78rem; color:#9ca3af; font-family:monospace;">
                                            @user.Id
                                        </span>
                                    </td>
                                    <td>
                                        <div style="font-weight:500; color:#111827;">@user.Fullname</div>
                                    </td>
                                    <td>
                                        <code style="font-size:0.82rem; color:#374151; background:#f3f4f6; padding:0.1rem 0.35rem; border-radius:4px;">
                                            @user.Login
                                        </code>
                                    </td>
                                    <td style="font-size:0.83rem; color:#6b7280;">@user.Email</td>
                                    <td>
                                        <span class="role-badge @AdminApp.Pages.Users.IndexModel.SystemRoleBadgeClass(user.SystemRole)">
                                            @AdminApp.Pages.Users.IndexModel.SystemRoleLabel(user.SystemRole)
                                        </span>
                                    </td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge" style="background:#d1fae5;color:#065f46;font-size:0.72rem;">Активен</span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background:#fee2e2;color:#991b1b;font-size:0.72rem;">Неактивен</span>
                                        }
                                    </td>
                                    <td style="font-size:0.78rem; color:#9ca3af;">
                                        @user.Created.ToString("dd.MM.yyyy")
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <button type="button"
                                                    class="btn btn-sm"
                                                    style="color:#4f8ef7; background:none; border:none; padding:0.2rem 0.4rem;"
                                                    title="Редактировать"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#editUserModal"
                                                    data-user-id="@user.Id"
                                                    data-user-fullname="@user.Fullname"
                                                    data-user-login="@user.Login"
                                                    data-user-email="@user.Email"
                                                    data-user-system-role="@((int)user.SystemRole)"
                                                    data-user-role-id="@user.RoleId"
                                                    data-user-certificate-id="@user.CertificateId"
                                                    data-user-created="@user.Created.ToString("O")"
                                                    data-user-is-active="@user.IsActive.ToString().ToLower()"
                                                    data-page="@Model.PageNumber"
                                                    data-search="@Model.SearchTerm">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            @if (user.IsActive)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm"
                                                        style="color:#ef4444; background:none; border:none; padding:0.2rem 0.4rem;"
                                                        title="Деактивировать"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteModal"
                                                        data-user-id="@user.Id"
                                                        data-user-name="@user.Fullname"
                                                        data-page="@Model.PageNumber"
                                                        data-search="@Model.SearchTerm">
                                                    <i class="bi bi-person-x"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (!Model.IsSearchActive)
                {
                    <!-- Pagination -->
                    <div class="pagination-bar">
                        @if (Model.PageNumber > 1)
                        {
                            <a asp-page="/Users/Index" asp-route-pageNumber="@(Model.PageNumber - 1)"
                               class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-chevron-left me-1"></i>Назад
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary" disabled>
                                <i class="bi bi-chevron-left me-1"></i>Назад
                            </button>
                        }

                        @if (Model.HasNextPage)
                        {
                            <a asp-page="/Users/Index" asp-route-pageNumber="@(Model.PageNumber + 1)"
                               class="btn btn-sm btn-outline-secondary">
                                Вперёд<i class="bi bi-chevron-right ms-1"></i>
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary" disabled>
                                Вперёд<i class="bi bi-chevron-right ms-1"></i>
                            </button>
                        }

                        <span class="page-info">Страница @Model.PageNumber</span>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Edit user modal -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:520px;">
        <div class="modal-content" style="border-radius:12px; border:none; box-shadow:0 20px 60px rgba(0,0,0,0.18);">
            <div class="modal-header" style="border-bottom:1px solid #f3f4f6; padding:1.25rem 1.5rem 1rem;">
                <div class="d-flex align-items-center gap-3">
                    <div style="width:40px;height:40px;background:#eff6ff;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <i class="bi bi-person-gear" style="color:#4f8ef7;font-size:1.1rem;"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0" id="editUserModalLabel"
                            style="font-size:0.95rem;font-weight:700;color:#111827;">
                            Редактировать пользователя
                        </h5>
                        <p class="mb-0" id="editUserSubtitle" style="font-size:0.78rem;color:#9ca3af;"></p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <form method="post" asp-page-handler="Update">
                <div class="modal-body" style="padding:1.25rem 1.5rem;">
                    <input type="hidden" asp-for="EditUser.Id" id="editUserId" />
                    <input type="hidden" asp-for="EditUser.PageNumber" id="editUserPageNumber" />
                    <input type="hidden" asp-for="EditUser.Search" id="editUserSearch" />
                    <input type="hidden" asp-for="EditUser.CertificateId" id="editUserCertificateId" />
                    <input type="hidden" asp-for="EditUser.Created" id="editUserCreated" />

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label" style="font-size:0.82rem;font-weight:600;color:#374151;">
                                ФИО <span class="text-danger">*</span>
                            </label>
                            <input asp-for="EditUser.Fullname" id="editUserFullname"
                                   class="form-control form-control-sm" />
                            <span asp-validation-for="EditUser.Fullname" class="text-danger" style="font-size:0.78rem;"></span>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" style="font-size:0.82rem;font-weight:600;color:#374151;">
                                Логин <span class="text-danger">*</span>
                            </label>
                            <input asp-for="EditUser.Login" id="editUserLogin"
                                   class="form-control form-control-sm" autocomplete="off" />
                            <span asp-validation-for="EditUser.Login" class="text-danger" style="font-size:0.78rem;"></span>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" style="font-size:0.82rem;font-weight:600;color:#374151;">
                                Email <span class="text-danger">*</span>
                            </label>
                            <input asp-for="EditUser.Email" id="editUserEmail"
                                   class="form-control form-control-sm" type="email" />
                            <span asp-validation-for="EditUser.Email" class="text-danger" style="font-size:0.78rem;"></span>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" style="font-size:0.82rem;font-weight:600;color:#374151;">
                                Системная роль
                            </label>
                            <select asp-for="EditUser.SystemRole" id="editUserSystemRole"
                                    class="form-select form-select-sm">
                                <option value="@Models.SystemRole.DocumentManager">Менеджер документов</option>
                                <option value="@Models.SystemRole.Signer">Подписант</option>
                                <option value="@Models.SystemRole.SystemAdmin">Системный администратор</option>
                            </select>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" style="font-size:0.82rem;font-weight:600;color:#374151;">
                                Роль (подразделение)
                            </label>
                            <select asp-for="EditUser.RoleId" id="editUserRoleId"
                                    asp-items="Model.RoleSelectList"
                                    class="form-select form-select-sm"></select>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch" style="padding-top:0.2rem;">
                                <input asp-for="EditUser.IsActive" id="editUserIsActive"
                                       class="form-check-input" type="checkbox" role="switch" />
                                <label class="form-check-label"
                                       style="font-size:0.85rem;font-weight:600;color:#374151;">
                                    Активный пользователь
                                </label>
                            </div>
                            <div style="font-size:0.75rem;color:#9ca3af;margin-top:0.2rem;margin-left:2.5rem;">
                                Снимите флаг для деактивации аккаунта
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="border-top:1px solid #f3f4f6; padding:1rem 1.5rem; gap:0.5rem;">
                    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal"
                            style="font-size:0.85rem;border-radius:7px;padding:0.45rem 1rem;">
                        Отмена
                    </button>
                    <button type="submit" class="btn btn-sm btn-primary"
                            style="font-size:0.85rem;border-radius:7px;padding:0.45rem 1rem;">
                        <i class="bi bi-check-lg me-1"></i>Сохранить
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete confirmation modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
        <div class="modal-content" style="border-radius:12px; border:none; box-shadow:0 20px 60px rgba(0,0,0,0.18);">
            <div class="modal-header" style="border-bottom:1px solid #f3f4f6; padding:1.25rem 1.5rem 1rem;">
                <div class="d-flex align-items-center gap-3">
                    <div style="width:40px;height:40px;background:#fee2e2;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <i class="bi bi-person-x" style="color:#dc2626;font-size:1.1rem;"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0" id="deleteModalLabel" style="font-size:0.95rem;font-weight:700;color:#111827;">
                            Деактивация пользователя
                        </h5>
                        <p class="mb-0" style="font-size:0.78rem;color:#9ca3af;">Действие можно отменить позже</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body" style="padding:1.25rem 1.5rem;">
                <p style="font-size:0.875rem;color:#374151;margin:0;">
                    Вы уверены, что хотите деактивировать пользователя
                    <strong id="deleteUserName" style="color:#111827;"></strong>?
                </p>
                <div class="mt-3 p-3" style="background:#fffbeb;border:1px solid #fde68a;border-radius:8px;">
                    <div class="d-flex gap-2">
                        <i class="bi bi-info-circle" style="color:#d97706;font-size:0.9rem;flex-shrink:0;margin-top:1px;"></i>
                        <p class="mb-0" style="font-size:0.8rem;color:#92400e;">
                            Пользователь не будет удалён из системы — только переведён в статус «Неактивен».
                            Это сохраняет все связанные документы.
                        </p>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="border-top:1px solid #f3f4f6; padding:1rem 1.5rem; gap:0.5rem;">
                <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal"
                        style="font-size:0.85rem;border-radius:7px;padding:0.45rem 1rem;">
                    Отмена
                </button>
                <form id="deleteForm" method="post">
                    <input type="hidden" name="id" id="deleteUserId" />
                    <input type="hidden" name="pageNumber" id="deletePageNumber" />
                    <input type="hidden" name="search" id="deleteSearch" />
                    @Html.AntiForgeryToken()
                    <button type="submit" asp-page-handler="Delete"
                            class="btn btn-sm btn-danger"
                            style="font-size:0.85rem;border-radius:7px;padding:0.45rem 1rem;">
                        <i class="bi bi-person-x me-1"></i>Деактивировать
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Edit modal
        const editUserModal = document.getElementById('editUserModal');
        editUserModal.addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;

            document.getElementById('editUserId').value            = btn.dataset.userId;
            document.getElementById('editUserPageNumber').value    = btn.dataset.page;
            document.getElementById('editUserSearch').value        = btn.dataset.search ?? '';
            document.getElementById('editUserCertificateId').value = btn.dataset.userCertificateId;
            document.getElementById('editUserCreated').value       = btn.dataset.userCreated;
            document.getElementById('editUserFullname').value      = btn.dataset.userFullname;
            document.getElementById('editUserLogin').value         = btn.dataset.userLogin;
            document.getElementById('editUserEmail').value         = btn.dataset.userEmail;
            document.getElementById('editUserSystemRole').value    = btn.dataset.userSystemRole;
            document.getElementById('editUserRoleId').value        = btn.dataset.userRoleId;
            document.getElementById('editUserIsActive').checked    = btn.dataset.userIsActive === 'true';
            document.getElementById('editUserSubtitle').textContent = btn.dataset.userLogin;
        });

        // Delete modal
        const deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            document.getElementById('deleteUserName').textContent = btn.dataset.userName;
            document.getElementById('deleteUserId').value = btn.dataset.userId;
            document.getElementById('deletePageNumber').value = btn.dataset.page;
            document.getElementById('deleteSearch').value = btn.dataset.search ?? '';

            const form = document.getElementById('deleteForm');
            form.action = '?handler=Delete';
        });
    </script>
}
