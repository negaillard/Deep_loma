@page
@model DemoApp.Pages.Documents.IndexModel
@using Models
@{
    ViewData["Title"] = "Отправка и статусы";
}

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success d-flex align-items-center gap-2 mb-3 py-2" role="alert">
        <i class="bi bi-check-circle-fill flex-shrink-0"></i>
        <span>@success</span>
    </div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger d-flex align-items-center gap-2 mb-3 py-2" role="alert">
        <i class="bi bi-exclamation-circle-fill flex-shrink-0"></i>
        <span>@error</span>
    </div>
}

<div class="row g-4">

    <!-- Upload form -->
    <div class="col-xl-4">
        <div class="card">
            <div class="card-header" data-bs-toggle="collapse" data-bs-target="#uploadForm" style="cursor:pointer;">
                <span><i class="bi bi-upload me-2"></i>Отправить документ</span>
                <i class="bi bi-chevron-down ms-auto float-end" style="font-size:0.8rem; color:#9ca3af;"></i>
            </div>
            <div class="collapse show" id="uploadForm">
                <div class="card-body">
                    <form method="post" asp-page-handler="Upload" enctype="multipart/form-data" id="uploadDocForm">

                        <div class="mb-2" id="titleBlock">
                            <label class="form-label" style="font-size:0.82rem;font-weight:600;color:#374151;">
                                Название <span class="text-danger" id="titleRequired">*</span>
                            </label>
                            <input asp-for="Title" id="titleInput" class="form-control form-control-sm"
                                   placeholder="Введите название документа" />
                            <div id="titleMultiHint" style="display:none;font-size:0.72rem;color:#6b7280;margin-top:0.25rem;">
                                При нескольких файлах будет использовано имя файла. Поле — необязательный префикс
                            </div>
                        </div>

                        <div class="mb-2">
                            <label class="form-label" style="font-size:0.82rem;font-weight:600;color:#374151;">
                                Описание 
                            </label>
                            <textarea asp-for="Description" class="form-control form-control-sm"
                                      rows="2" placeholder="Описание"></textarea>
                        </div>

                        <div class="mb-2">
                            <label class="form-label" style="font-size:0.82rem;font-weight:600;color:#374151;">
                                Файл <span class="text-danger">*</span>
                            </label>
                            <input id="fileInput" name="UploadedFile" type="file"
                                   class="form-control form-control-sm"
                                   accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg" multiple />
                            <div style="font-size:0.72rem; color:#9ca3af; margin-top:0.25rem;">
                                PDF, Word, Excel, изображения · можно выбрать несколько
                            </div>
                            <div id="fileQueue" style="display:none; margin-top:0.5rem; border:1px solid #e5e7eb; border-radius:6px; overflow:hidden;"></div>
                        </div>

                        <div class="mb-2">
                            <div class="form-check form-switch" style="padding-left:2.5rem;">
                                <input type="hidden" name="IsSequential" value="false" />
                                <input class="form-check-input" type="checkbox" id="isSequentialCheck"
                                       name="IsSequential" value="true" style="cursor:pointer;" />
                                <label class="form-check-label" for="isSequentialCheck"
                                       style="font-size:0.82rem;font-weight:600;color:#374151;cursor:pointer;">
                                    Последовательная подпись
                                </label>
                            </div>
                            <div style="font-size:0.72rem; color:#9ca3af; margin-top:0.2rem; padding-left:2.5rem;">
                                Каждый следующий подписант получит документ только после предыдущего
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" style="font-size:0.82rem;font-weight:600;color:#374151;">
                                Подписанты <span class="text-danger">*</span>
                            </label>

                            <!-- Selected signers display -->
                            <div id="signerChips" class="mb-2" style="min-height:28px; display:flex; flex-wrap:wrap; gap:0.3rem;"></div>

                            <!-- Hidden inputs for selected IDs -->
                            <div id="signerInputs"></div>

                            <!-- Search field -->
                            <div class="position-relative">
                                <input type="text" id="userSearchInput" class="form-control form-control-sm"
                                       placeholder="Поиск по ФИО..." autocomplete="off" />
                                <div id="searchResults" class="search-results" style="display:none;"></div>
                            </div>
                            <div id="signerHint" style="font-size:0.72rem; color:#9ca3af; margin-top:0.25rem;">
                                Введите минимум 2 символа для поиска
                            </div>
                        </div>

                        <button type="submit" id="submitBtn" class="btn btn-primary btn-sm w-100">
                            <i class="bi bi-send me-1"></i>Отправить на подпись
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Documents status table -->
    <div class="col-xl-8">
        <div class="card">
            <div class="card-header d-flex align-items-center gap-3 flex-wrap">
                <span><i class="bi bi-clock-history me-2"></i>Документы на подпись</span>

                <!-- Status filter tabs -->
                <div class="d-flex gap-1 ms-auto flex-wrap">
                    <a asp-page="/Documents/Index" asp-route-p="1" asp-route-pageSize="@Model.PageSize"
                       class="btn btn-sm @(string.IsNullOrEmpty(Model.StatusFilter) ? "btn-primary" : "btn-outline-secondary")"
                       style="font-size:0.75rem; padding:0.2rem 0.6rem; border-radius:20px;">
                        Все
                    </a>
                    <a asp-page="/Documents/Index" asp-route-statusFilter="NOT_SIGNED" asp-route-p="1" asp-route-pageSize="@Model.PageSize"
                       class="btn btn-sm @(Model.StatusFilter == "NOT_SIGNED" ? "btn-warning" : "btn-outline-secondary")"
                       style="font-size:0.75rem; padding:0.2rem 0.6rem; border-radius:20px;">
                        Ожидают
                    </a>
                    <a asp-page="/Documents/Index" asp-route-statusFilter="PARTLY_SIGNED" asp-route-p="1" asp-route-pageSize="@Model.PageSize"
                       class="btn btn-sm @(Model.StatusFilter == "PARTLY_SIGNED" ? "btn-info" : "btn-outline-secondary")"
                       style="font-size:0.75rem; padding:0.2rem 0.6rem; border-radius:20px;">
                        Частичные
                    </a>
                    <a asp-page="/Documents/Index" asp-route-statusFilter="DECLINED" asp-route-p="1" asp-route-pageSize="@Model.PageSize"
                       class="btn btn-sm @(Model.StatusFilter == "DECLINED" ? "btn-danger" : "btn-outline-secondary")"
                       style="font-size:0.75rem; padding:0.2rem 0.6rem; border-radius:20px;">
                        Отклонённые
                    </a>
                </div>
            </div>

            @if (Model.Documents.Count == 0)
            {
                <div class="card-body text-center py-5">
                    <i class="bi bi-inbox" style="font-size: 2.5rem; color: #d1d5db;"></i>
                    <p class="mt-2 mb-0" style="color: #9ca3af; font-size: 0.875rem;">
                        Нет документов для отображения
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th style="width:40px;">#</th>
                                <th>Документ</th>
                                <th>Статус</th>
                                <th>Дата отправки</th>
                                <th style="width:80px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doc in Model.Documents)
                            {
                                <tr>
                                    <td>
                                        <span style="font-size:0.78rem; color:#9ca3af; font-family:monospace;">
                                            @doc.Id
                                        </span>
                                    </td>
                                    <td>
                                        <div style="font-weight:500; color:#111827;">@doc.Title</div>
                                        @if (!string.IsNullOrEmpty(doc.Description))
                                        {
                                            <div style="font-size:0.78rem; color:#9ca3af; margin-top:0.1rem;">
                                                @(doc.Description.Length > 60 ? doc.Description[..60] + "…" : doc.Description)
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <span class="status-badge @IndexModel.StatusBadgeClass(doc.Status)">
                                            <i class="bi @IndexModel.StatusIcon(doc.Status)"></i>
                                            @IndexModel.StatusLabel(doc.Status)
                                        </span>
                                    </td>
                                    <td style="font-size:0.82rem; color:#6b7280;">
                                        @doc.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <button type="button"
                                                    class="btn btn-sm"
                                                    style="color:#4f8ef7; background:none; border:none; padding:0.2rem 0.4rem;"
                                                    title="Подробнее"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#docDetailModal"
                                                    data-doc-id="@doc.Id"
                                                    data-doc-title="@doc.Title"
                                                    data-doc-description="@doc.Description"
                                                    data-doc-status="@IndexModel.StatusLabel(doc.Status)"
                                                    data-doc-status-class="@IndexModel.StatusBadgeClass(doc.Status)"
                                                    data-doc-status-icon="@IndexModel.StatusIcon(doc.Status)"
                                                    data-doc-date="@doc.CreatedAt.ToString("dd.MM.yyyy HH:mm")"
                                                    data-doc-sequential="@doc.IsSequential.ToString().ToLower()">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <a asp-page-handler="Download"
                                               asp-route-id="@doc.Id"
                                               class="btn btn-sm"
                                               style="color:#059669; background:none; border:none; padding:0.2rem 0.4rem;"
                                               title="Скачать"
                                               target="_blank">
                                                <i class="bi bi-download"></i>
                                            </a>
                                            <button type="button"
                                                    class="btn btn-sm"
                                                    style="color:#ef4444; background:none; border:none; padding:0.2rem 0.4rem;"
                                                    title="Удалить"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteDocModal"
                                                    data-doc-id="@doc.Id"
                                                    data-doc-title="@doc.Title">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="pagination-bar">
                        @if (Model.PageNumber > 1)
                        {
                            <a asp-page="/Documents/Index"
                               asp-route-statusFilter="@Model.StatusFilter"
                               asp-route-p="@(Model.PageNumber - 1)"
                               asp-route-pageSize="@Model.PageSize"
                               class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-chevron-left me-1"></i>Назад
                            </a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled>
                                <i class="bi bi-chevron-left me-1"></i>Назад
                            </button>
                        }

                        @if (Model.HasNextPage)
                        {
                            <a asp-page="/Documents/Index"
                               asp-route-statusFilter="@Model.StatusFilter"
                               asp-route-p="@(Model.PageNumber + 1)"
                               asp-route-pageSize="@Model.PageSize"
                               class="btn btn-sm btn-outline-secondary">
                                Вперёд<i class="bi bi-chevron-right ms-1"></i>
                            </a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled>
                                Вперёд<i class="bi bi-chevron-right ms-1"></i>
                            </button>
                        }

                        <span class="page-info">Страница @Model.PageNumber</span>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Document detail modal -->
<div class="modal fade" id="docDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:500px;">
        <div class="modal-content" style="border-radius:12px; border:none; box-shadow:0 20px 60px rgba(0,0,0,0.18);">
            <div class="modal-header" style="border-bottom:1px solid #f3f4f6; padding:1.25rem 1.5rem 1rem;">
                <div class="d-flex align-items-center gap-3">
                    <div style="width:40px;height:40px;background:#eff6ff;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <i class="bi bi-file-earmark-text" style="color:#4f8ef7;font-size:1.1rem;"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0" id="docDetailTitle"
                            style="font-size:0.95rem;font-weight:700;color:#111827;"></h5>
                        <p class="mb-0" style="font-size:0.78rem;color:#9ca3af;" id="docDetailDate"></p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding:1.25rem 1.5rem;">
                <div class="mb-3">
                    <div style="font-size:0.78rem;font-weight:600;color:#6b7280;margin-bottom:0.35rem;">СТАТУС</div>
                    <span id="docDetailStatus" class="status-badge"></span>
                </div>
                <div id="docDetailDescBlock" class="mb-3">
                    <div style="font-size:0.78rem;font-weight:600;color:#6b7280;margin-bottom:0.35rem;">ОПИСАНИЕ</div>
                    <p id="docDetailDescription" style="font-size:0.875rem;color:#374151;margin:0;"></p>
                </div>
                <div>
                    <div style="font-size:0.78rem;font-weight:600;color:#6b7280;margin-bottom:0.5rem;">ПОДПИСАНТЫ</div>
                    <div id="docDetailSigners" style="font-size:0.85rem;color:#374151;">
                        <div class="d-flex align-items-center gap-2" style="color:#9ca3af;">
                            <div class="spinner-border spinner-border-sm"></div>
                            Загрузка...
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="border-top:1px solid #f3f4f6; padding:1rem 1.5rem;">
                <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal"
                        style="font-size:0.85rem;border-radius:7px;padding:0.45rem 1rem;">
                    Закрыть
                </button>
                <a id="docDetailDownload" href="#" target="_blank"
                   class="btn btn-sm btn-primary"
                   style="font-size:0.85rem;border-radius:7px;padding:0.45rem 1rem;">
                    <i class="bi bi-download me-1"></i>Скачать
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Delete document modal -->
<div class="modal fade" id="deleteDocModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
        <div class="modal-content" style="border-radius:12px; border:none; box-shadow:0 20px 60px rgba(0,0,0,0.18);">
            <div class="modal-header" style="border-bottom:1px solid #f3f4f6; padding:1.25rem 1.5rem 1rem;">
                <div class="d-flex align-items-center gap-3">
                    <div style="width:40px;height:40px;background:#fee2e2;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <i class="bi bi-trash" style="color:#dc2626;font-size:1.1rem;"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0" style="font-size:0.95rem;font-weight:700;color:#111827;">
                            Удалить документ
                        </h5>
                        <p class="mb-0" style="font-size:0.78rem;color:#9ca3af;">Документ будет скрыт из системы</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding:1.25rem 1.5rem;">
                <p style="font-size:0.875rem;color:#374151;margin:0;">
                    Вы уверены, что хотите удалить документ
                    <strong id="deleteDocTitle" style="color:#111827;"></strong>?
                </p>
            </div>
            <div class="modal-footer" style="border-top:1px solid #f3f4f6; padding:1rem 1.5rem; gap:0.5rem;">
                <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal"
                        style="font-size:0.85rem;border-radius:7px;padding:0.45rem 1rem;">
                    Отмена
                </button>
                <form id="deleteDocForm" method="post">
                    <input type="hidden" name="id" id="deleteDocId" />
                    @Html.AntiForgeryToken()
                    <button type="submit" asp-page-handler="Delete"
                            class="btn btn-sm btn-danger"
                            style="font-size:0.85rem;border-radius:7px;padding:0.45rem 1rem;">
                        <i class="bi bi-trash me-1"></i>Удалить
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>

    // ── User search & signer chips ────────────────────────────────────────
    let signerOrder = [];
    const signersMap = new Map();

    const sequentialCheck = document.getElementById('isSequentialCheck');
    const searchInput     = document.getElementById('userSearchInput');
    const searchResults   = document.getElementById('searchResults');
    const signerChips     = document.getElementById('signerChips');
    const signerInputs    = document.getElementById('signerInputs');
    const signerHint      = document.getElementById('signerHint');
    const fileInput       = document.getElementById('fileInput');
    const fileQueue       = document.getElementById('fileQueue');
    const titleInput      = document.getElementById('titleInput');
    const titleMultiHint  = document.getElementById('titleMultiHint');
    const titleRequired   = document.getElementById('titleRequired');
    const submitBtn       = document.getElementById('submitBtn');
    const uploadForm      = document.getElementById('uploadDocForm');

    let searchTimer  = null;
    let isSequential = false;

    // ── Sequential toggle ─────────────────────────────────────────────────
    sequentialCheck.addEventListener('change', () => {
        isSequential = sequentialCheck.checked;
        signerHint.textContent = isSequential
            ? 'Перетаскивайте стрелками для изменения порядка подписания'
            : 'Введите минимум 2 символа для поиска';
        renderChips();
    });

    // ── File input → queue ────────────────────────────────────────────────
    fileInput.addEventListener('change', () => {
        const files = Array.from(fileInput.files);
        if (files.length > 1) {
            titleInput.readOnly = true;
            titleInput.style.background = '#f9fafb';
            titleInput.placeholder = 'Необязательный префикс названия';
            titleRequired.style.display = 'none';
            titleMultiHint.style.display = 'block';
            renderFileQueue(files);
        } else {
            titleInput.readOnly = false;
            titleInput.style.background = '';
            titleInput.placeholder = 'Введите название документа';
            titleRequired.style.display = '';
            titleMultiHint.style.display = 'none';
            fileQueue.style.display = 'none';
        }
    });

    function renderFileQueue(files) {
        fileQueue.style.display = 'block';
        fileQueue.innerHTML = files.map((f, i) =>
            `<div id="fq-${i}" class="d-flex align-items-center gap-2 px-2 py-1"
                  style="font-size:0.8rem;color:#374151;${i < files.length - 1 ? 'border-bottom:1px solid #f3f4f6;' : ''}">
                <i class="bi bi-file-earmark" style="color:#9ca3af;flex-shrink:0;"></i>
                <span class="text-truncate flex-grow-1">${f.name}</span>
                <span id="fq-status-${i}" style="font-size:0.72rem;color:#9ca3af;white-space:nowrap;">ожидание</span>
            </div>`
        ).join('');
    }

    function setFileStatus(i, icon, text, color) {
        const el = document.getElementById(`fq-status-${i}`);
        if (el) el.innerHTML = `<i class="bi ${icon}" style="color:${color};"></i> ${text}`;
    }

    // ── Form submit — multi-file AJAX upload ──────────────────────────────
    uploadForm.addEventListener('submit', async function (e) {
        e.preventDefault();

        const files = Array.from(fileInput.files);
        const title = titleInput.value.trim();
        const description = document.querySelector('[name="Description"]').value.trim();
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

        if (files.length === 0) { showUploadError('Выберите файл для загрузки'); return; }
        if (files.length === 1 && !title) { showUploadError('Введите название документа'); return; }
        if (signerOrder.length === 0) { showUploadError('Выберите хотя бы одного подписанта'); return; }

        submitBtn.disabled = true;

        let successCount = 0;
        const errors = [];

        for (let i = 0; i < files.length; i++) {
            const file = files[i];
            const docTitle = files.length === 1
                ? title
                : (title ? `${title} — ${nameWithoutExt(file.name)}` : nameWithoutExt(file.name));

            submitBtn.innerHTML =
                `<span class="spinner-border spinner-border-sm me-1"></span>` +
                `Загрузка ${i + 1} из ${files.length}...`;

            if (files.length > 1) setFileStatus(i, 'bi-hourglass-split', 'загрузка...', '#6b7280');

            try {
                const fd = new FormData();
                fd.append('Title', docTitle);
                fd.append('Description', description);
                signerOrder.forEach(id => fd.append('SignerIds', id));
                fd.append('IsSequential', isSequential ? 'true' : 'false');
                fd.append('UploadedFile', file, file.name);
                fd.append('__RequestVerificationToken', token);

                const resp   = await fetch('?handler=UploadAjax', { method: 'POST', body: fd });
                const result = await resp.json();

                if (result.success) {
                    successCount++;
                    if (files.length > 1) setFileStatus(i, 'bi-check-circle-fill', 'готово', '#059669');
                } else {
                    errors.push(`${file.name}: ${result.message}`);
                    if (files.length > 1) setFileStatus(i, 'bi-x-circle-fill', 'ошибка', '#dc2626');
                }
            } catch {
                errors.push(`${file.name}: ошибка сети`);
                if (files.length > 1) setFileStatus(i, 'bi-x-circle-fill', 'ошибка сети', '#dc2626');
            }
        }

        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i class="bi bi-send me-1"></i>Отправить на подпись';

        if (errors.length === 0) {
            setTimeout(() => window.location.reload(), 600);
        } else if (successCount > 0) {
            showUploadError(`Загружено ${successCount} из ${files.length}. Ошибки: ${errors.join('; ')}`);
        } else {
            showUploadError(errors.join('; '));
        }
    });

    function nameWithoutExt(name) {
        const idx = name.lastIndexOf('.');
        return idx > 0 ? name.slice(0, idx) : name;
    }

    function showUploadError(msg) {
        let el = document.getElementById('uploadInlineError');
        if (!el) {
            el = document.createElement('div');
            el.id = 'uploadInlineError';
            el.className = 'alert alert-danger d-flex align-items-center gap-2 mt-2 py-2';
            el.style.fontSize = '0.82rem';
            submitBtn.insertAdjacentElement('beforebegin', el);
        }
        el.innerHTML = `<i class="bi bi-exclamation-circle-fill flex-shrink-0"></i><span>${msg}</span>`;
    }

    searchInput.addEventListener('input', () => {
        clearTimeout(searchTimer);
        const q = searchInput.value.trim();
        if (q.length < 2) { searchResults.style.display = 'none'; return; }
        searchTimer = setTimeout(() => fetchUsers(q), 280);
    });

    searchInput.addEventListener('blur', () => {
        setTimeout(() => { searchResults.style.display = 'none'; }, 200);
    });

    async function fetchUsers(query) {
        try {
            const resp = await fetch(`/Documents/Index?handler=SearchUsers&query=${encodeURIComponent(query)}`);
            const users = await resp.json();
            renderResults(users);
        } catch { searchResults.style.display = 'none'; }
    }

    function renderResults(users) {
        searchResults.innerHTML = '';
        if (!users || users.length === 0) {
            searchResults.innerHTML = '<div class="search-result-item" style="color:#9ca3af;">Ничего не найдено</div>';
            searchResults.style.display = 'block';
            return;
        }
        users.forEach(u => {
            const div = document.createElement('div');
            div.className = 'search-result-item';
            div.innerHTML = `<div class="user-name">${u.fullname}</div><div class="user-login">${u.login}</div>`;
            div.addEventListener('mousedown', () => addSigner(u));
            searchResults.appendChild(div);
        });
        searchResults.style.display = 'block';
    }

    function addSigner(user) {
        if (signersMap.has(user.id)) return;
        signersMap.set(user.id, user);
        signerOrder.push(user.id);
        renderChips();
        searchInput.value = '';
        searchResults.style.display = 'none';
    }

    function removeSigner(id) {
        signersMap.delete(id);
        signerOrder = signerOrder.filter(x => x !== id);
        renderChips();
    }

    function moveSignerUp(id) {
        const idx = signerOrder.indexOf(id);
        if (idx <= 0) return;
        [signerOrder[idx - 1], signerOrder[idx]] = [signerOrder[idx], signerOrder[idx - 1]];
        renderChips();
    }

    function moveSignerDown(id) {
        const idx = signerOrder.indexOf(id);
        if (idx < 0 || idx >= signerOrder.length - 1) return;
        [signerOrder[idx], signerOrder[idx + 1]] = [signerOrder[idx + 1], signerOrder[idx]];
        renderChips();
    }

    function renderChips() {
        signerChips.innerHTML = '';
        signerInputs.innerHTML = '';
        signerOrder.forEach((id, index) => {
            const user = signersMap.get(id);
            const chip = document.createElement('span');
            chip.className = 'signer-chip';

            if (isSequential) {
                const isFirst = index === 0;
                const isLast  = index === signerOrder.length - 1;
                chip.innerHTML =
                    `<span style="display:inline-flex;align-items:center;justify-content:center;` +
                    `width:18px;height:18px;background:#4f8ef7;color:#fff;border-radius:50%;` +
                    `font-size:0.65rem;font-weight:700;flex-shrink:0;margin-right:0.3rem;">${index + 1}</span>` +
                    `<i class="bi bi-person-fill"></i>${user.fullname}` +
                    `<button type="button" class="remove-btn" title="Выше" ${isFirst ? 'disabled style="opacity:0.3;"' : ''} onclick="moveSignerUp(${id})"><i class="bi bi-arrow-up"></i></button>` +
                    `<button type="button" class="remove-btn" title="Ниже" ${isLast  ? 'disabled style="opacity:0.3;"' : ''} onclick="moveSignerDown(${id})"><i class="bi bi-arrow-down"></i></button>` +
                    `<button type="button" class="remove-btn" onclick="removeSigner(${id})"><i class="bi bi-x"></i></button>`;
            } else {
                chip.innerHTML =
                    `<i class="bi bi-person-fill"></i>${user.fullname}` +
                    `<button type="button" class="remove-btn" onclick="removeSigner(${id})"><i class="bi bi-x"></i></button>`;
            }

            signerChips.appendChild(chip);

            const input = document.createElement('input');
            input.type  = 'hidden';
            input.name  = 'SignerIds';
            input.value = id;
            signerInputs.appendChild(input);
        });
    }

    // ── Document detail modal ─────────────────────────────────────────────
    const docDetailModal = document.getElementById('docDetailModal');
    docDetailModal.addEventListener('show.bs.modal', async function (event) {
        const btn        = event.relatedTarget;
        const id         = btn.dataset.docId;
        const title      = btn.dataset.docTitle;
        const description= btn.dataset.docDescription;
        const status     = btn.dataset.docStatus;
        const statusClass= btn.dataset.docStatusClass;
        const statusIcon = btn.dataset.docStatusIcon;
        const date       = btn.dataset.docDate;
        const sequential = btn.dataset.docSequential === 'true';

        document.getElementById('docDetailTitle').textContent = title;
        document.getElementById('docDetailDate').textContent  = date;
        document.getElementById('docDetailDownload').href     = `?handler=Download&id=${id}`;

        const statusEl = document.getElementById('docDetailStatus');
        statusEl.className = `status-badge ${statusClass}`;
        statusEl.innerHTML = `<i class="bi ${statusIcon}"></i>${status}`;

        const descBlock = document.getElementById('docDetailDescBlock');
        if (description) {
            document.getElementById('docDetailDescription').textContent = description;
            descBlock.style.display = 'block';
        } else {
            descBlock.style.display = 'none';
        }

        // Load signers
        const signersEl = document.getElementById('docDetailSigners');
        signersEl.innerHTML = '<div class="d-flex align-items-center gap-2" style="color:#9ca3af;"><div class="spinner-border spinner-border-sm"></div> Загрузка...</div>';

        try {
            const resp = await fetch(`?handler=Signers&id=${id}`, { headers: { 'Accept': 'application/json' } });
            if (resp.ok) {
                let signers = await resp.json();
                if (signers.length === 0) {
                    signersEl.innerHTML = '<span style="color:#9ca3af;font-size:0.82rem;">Нет подписантов</span>';
                } else {
                    if (sequential) signers = signers.slice().sort((a, b) => a.order - b.order);

                    signersEl.innerHTML = signers.map((s, idx) => {
                        const isPending = s.signingStatus === 3;
                        const sc = s.signingStatus === 1 ? 'signed'
                                 : s.signingStatus === 2 ? 'declined'
                                 : isPending            ? 'partly'
                                 : 'not-signed';
                        const si = s.signingStatus === 1 ? 'bi-check-circle'
                                 : s.signingStatus === 2 ? 'bi-x-circle'
                                 : isPending            ? 'bi-hourglass-top'
                                 : 'bi-hourglass-split';
                        const sl = s.signingStatus === 1 ? 'Подписан'
                                 : s.signingStatus === 2 ? 'Отклонил'
                                 : isPending            ? 'В обработке'
                                 : 'Ожидает';

                        const orderBadge = sequential
                            ? `<span style="display:inline-flex;align-items:center;justify-content:center;` +
                              `width:18px;height:18px;background:#e5e7eb;color:#374151;border-radius:50%;` +
                              `font-size:0.65rem;font-weight:700;flex-shrink:0;margin-right:0.4rem;">${idx + 1}</span>`
                            : '';

                        return `<div class="d-flex align-items-center justify-content-between py-1" style="border-bottom:1px solid #f3f4f6;">
                            <span style="font-size:0.85rem;color:#374151;display:flex;align-items:center;">
                                ${orderBadge}<i class="bi bi-person-fill me-1" style="color:#9ca3af;"></i>${s.userFullname ?? ('Пользователь #' + s.userId)}
                            </span>
                            <span class="status-badge ${sc}" style="font-size:0.72rem;"><i class="bi ${si}"></i>${sl}</span>
                        </div>`;
                    }).join('');
                }
            } else {
                signersEl.innerHTML = '<span style="color:#9ca3af;font-size:0.82rem;">Не удалось загрузить</span>';
            }
        } catch {
            signersEl.innerHTML = '<span style="color:#9ca3af;font-size:0.82rem;">Не удалось загрузить</span>';
        }
    });

    // ── Delete document modal ─────────────────────────────────────────────
    const deleteDocModal = document.getElementById('deleteDocModal');
    deleteDocModal.addEventListener('show.bs.modal', function (event) {
        const btn = event.relatedTarget;
        document.getElementById('deleteDocTitle').textContent = btn.dataset.docTitle;
        document.getElementById('deleteDocId').value = btn.dataset.docId;
        document.getElementById('deleteDocForm').action = '?handler=Delete';
    });
</script>
}
