@page
@model DemoApp.Pages.Roles.IndexModel
@{
    ViewData["Title"] = "Роли";
}

<div class="row g-4">

    <!-- Create form -->
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-plus-circle me-2"></i>Новая роль
            </div>
            <div class="card-body">

                @if (TempData["SuccessMessage"] is string success)
                {
                    <div class="alert alert-success d-flex align-items-center gap-2 py-2" role="alert">
                        <i class="bi bi-check-circle-fill flex-shrink-0"></i>
                        <span>@success</span>
                    </div>
                }
                @if (TempData["ErrorMessage"] is string error)
                {
                    <div class="alert alert-danger d-flex align-items-center gap-2 py-2" role="alert">
                        <i class="bi bi-exclamation-circle-fill flex-shrink-0"></i>
                        <span>@error</span>
                    </div>
                }

                <form method="post" asp-page-handler="Create">
                    <div class="mb-3">
                        <label asp-for="NewRole.Name" class="form-label" style="font-size:0.82rem; font-weight:600; color:#374151;">
                            Название <span class="text-danger">*</span>
                        </label>
                        <input asp-for="NewRole.Name" class="form-control form-control-sm"
                               placeholder="Например: Юридический отдел" />
                        <span asp-validation-for="NewRole.Name" class="text-danger" style="font-size:0.78rem;"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="NewRole.Description" class="form-label" style="font-size:0.82rem; font-weight:600; color:#374151;">
                            Описание
                        </label>
                        <textarea asp-for="NewRole.Description" class="form-control form-control-sm"
                                  rows="3" placeholder="Краткое описание роли..."></textarea>
                        <span asp-validation-for="NewRole.Description" class="text-danger" style="font-size:0.78rem;"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-sm w-100">
                        <i class="bi bi-plus-circle me-1"></i>Создать роль
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Roles list -->
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <span><i class="bi bi-list-ul me-2"></i>Список ролей</span>
                <span class="badge bg-secondary" style="font-size:0.72rem;">
                    Страница @Model.PageNumber
                </span>
            </div>

            @if (Model.Roles.Count == 0)
            {
                <div class="card-body text-center py-5">
                    <i class="bi bi-inbox" style="font-size: 2.5rem; color: #d1d5db;"></i>
                    <p class="mt-2 mb-0" style="color: #9ca3af; font-size: 0.875rem;">
                        Роли не найдены
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th style="width:50px;">#</th>
                                <th>Название</th>
                                <th>Описание</th>
                                <th style="width:90px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var role in Model.Roles)
                            {
                                <tr>
                                    <td>
                                        <span style="font-size:0.78rem; color:#9ca3af; font-family:monospace;">
                                            @role.Id
                                        </span>
                                    </td>
                                    <td>
                                        <span class="fw-500" style="color:#111827;">@role.Name</span>
                                    </td>
                                    <td>
                                        <span style="color:#6b7280; font-size:0.83rem;">
                                            @(string.IsNullOrWhiteSpace(role.Description) ? "—" : role.Description)
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <button type="button"
                                                    class="btn btn-sm"
                                                    style="color:#4f8ef7; background:none; border:none; padding:0.2rem 0.4rem;"
                                                    title="Редактировать"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#editRoleModal"
                                                    data-role-id="@role.Id"
                                                    data-role-name="@role.Name"
                                                    data-role-description="@role.Description"
                                                    data-page="@Model.PageNumber">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <form method="post" asp-page-handler="Delete"
                                                  asp-route-id="@role.Id"
                                                  asp-route-pageNumber="@Model.PageNumber"
                                                  onsubmit="return confirm('Удалить роль «@role.Name»?')">
                                                <button type="submit"
                                                        class="btn btn-sm"
                                                        style="color:#ef4444; background:none; border:none; padding:0.2rem 0.4rem;"
                                                        title="Удалить">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="pagination-bar">
                    @if (Model.PageNumber > 1)
                    {
                        <a asp-page="/Roles/Index" asp-route-pageNumber="@(Model.PageNumber - 1)"
                           class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-chevron-left me-1"></i>Назад
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-secondary" disabled>
                            <i class="bi bi-chevron-left me-1"></i>Назад
                        </button>
                    }

                    @if (Model.HasNextPage)
                    {
                        <a asp-page="/Roles/Index" asp-route-pageNumber="@(Model.PageNumber + 1)"
                           class="btn btn-sm btn-outline-secondary">
                            Вперёд<i class="bi bi-chevron-right ms-1"></i>
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-secondary" disabled>
                            Вперёд<i class="bi bi-chevron-right ms-1"></i>
                        </button>
                    }

                    <span class="page-info">Страница @Model.PageNumber</span>
                </div>
            }
        </div>
    </div>
</div>

<!-- Edit role modal -->
<div class="modal fade" id="editRoleModal" tabindex="-1" aria-labelledby="editRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:440px;">
        <div class="modal-content" style="border-radius:12px; border:none; box-shadow:0 20px 60px rgba(0,0,0,0.18);">
            <div class="modal-header" style="border-bottom:1px solid #f3f4f6; padding:1.25rem 1.5rem 1rem;">
                <div class="d-flex align-items-center gap-3">
                    <div style="width:40px;height:40px;background:#eff6ff;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <i class="bi bi-pencil" style="color:#4f8ef7;font-size:1.05rem;"></i>
                    </div>
                    <h5 class="modal-title mb-0" id="editRoleModalLabel"
                        style="font-size:0.95rem;font-weight:700;color:#111827;">
                        Редактировать роль
                    </h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <form method="post" asp-page-handler="Update">
                <div class="modal-body" style="padding:1.25rem 1.5rem;">
                    <input type="hidden" asp-for="EditRole.Id" id="editRoleId" />
                    <input type="hidden" asp-for="EditRole.PageNumber" id="editRolePageNumber" />

                    <div class="mb-3">
                        <label class="form-label" style="font-size:0.82rem;font-weight:600;color:#374151;">
                            Название <span class="text-danger">*</span>
                        </label>
                        <input asp-for="EditRole.Name" id="editRoleName"
                               class="form-control form-control-sm" />
                        <span asp-validation-for="EditRole.Name" class="text-danger" style="font-size:0.78rem;"></span>
                    </div>

                    <div class="mb-1">
                        <label class="form-label" style="font-size:0.82rem;font-weight:600;color:#374151;">
                            Описание
                        </label>
                        <textarea asp-for="EditRole.Description" id="editRoleDescription"
                                  class="form-control form-control-sm" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer" style="border-top:1px solid #f3f4f6; padding:1rem 1.5rem; gap:0.5rem;">
                    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal"
                            style="font-size:0.85rem;border-radius:7px;padding:0.45rem 1rem;">
                        Отмена
                    </button>
                    <button type="submit" class="btn btn-sm btn-primary"
                            style="font-size:0.85rem;border-radius:7px;padding:0.45rem 1rem;">
                        <i class="bi bi-check-lg me-1"></i>Сохранить
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const editRoleModal = document.getElementById('editRoleModal');
        editRoleModal.addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            document.getElementById('editRoleId').value = btn.dataset.roleId;
            document.getElementById('editRolePageNumber').value = btn.dataset.page;
            document.getElementById('editRoleName').value = btn.dataset.roleName;
            document.getElementById('editRoleDescription').value = btn.dataset.roleDescription ?? '';
        });
    </script>
}
