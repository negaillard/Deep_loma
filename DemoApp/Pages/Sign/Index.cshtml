@page "/Sign"
@model DemoApp.Pages.Sign.IndexModel
@using Models
@using Contracts.ViewModels
@{
    ViewData["Title"] = "Документы на подписание";
    ViewData["ActivePage"] = "Sign";
}

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success d-flex align-items-center gap-2 mb-3 py-2" role="alert">
        <i class="bi bi-check-circle-fill flex-shrink-0"></i>
        <span>@success</span>
    </div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger d-flex align-items-center gap-2 mb-3 py-2" role="alert">
        <i class="bi bi-exclamation-circle-fill flex-shrink-0"></i>
        <span>@error</span>
    </div>
}

<!-- Счётчики вкладок -->
<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="card text-center py-3" style="border-color: #fed7aa;">
            <div style="font-size:1.6rem; font-weight:700; color:#c2410c;">@Model.PendingDocs.TotalCount</div>
            <div style="font-size:0.78rem; color:#9ca3af;">Ожидают подписи</div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card text-center py-3" style="border-color: #a7f3d0;">
            <div style="font-size:1.6rem; font-weight:700; color:#065f46;">@Model.SignedDocs.TotalCount</div>
            <div style="font-size:0.78rem; color:#9ca3af;">Подписано</div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card text-center py-3" style="border-color: #fecaca;">
            <div style="font-size:1.6rem; font-weight:700; color:#991b1b;">@Model.DeclinedDocs.TotalCount</div>
            <div style="font-size:0.78rem; color:#9ca3af;">Отклонено</div>
        </div>
    </div>
</div>

<!-- Вкладки -->
<ul class="nav nav-tabs mb-0" id="docTabs" role="tablist" style="border-bottom: none;">
    <li class="nav-item">
        <button class="nav-link @(Model.ActiveTab == "pending" ? "active" : "")"
                data-bs-toggle="tab" data-bs-target="#tab-pending" type="button">
            <i class="bi bi-hourglass-split me-1"></i>
            Не подписанные
            <span class="badge ms-1" style="background:#fed7aa; color:#c2410c; font-size:0.7rem;">
                @Model.PendingDocs.TotalCount
            </span>
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(Model.ActiveTab == "signed" ? "active" : "")"
                data-bs-toggle="tab" data-bs-target="#tab-signed" type="button">
            <i class="bi bi-check-circle me-1"></i>
            Подписанные
            <span class="badge ms-1" style="background:#a7f3d0; color:#065f46; font-size:0.7rem;">
                @Model.SignedDocs.TotalCount
            </span>
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(Model.ActiveTab == "declined" ? "active" : "")"
                data-bs-toggle="tab" data-bs-target="#tab-declined" type="button">
            <i class="bi bi-x-circle me-1"></i>
            Отклонённые
            <span class="badge ms-1" style="background:#fecaca; color:#991b1b; font-size:0.7rem;">
                @Model.DeclinedDocs.TotalCount
            </span>
        </button>
    </li>
</ul>

<div class="tab-content" style="background:#fff; border:1px solid #e8ecf0; border-top:none; border-radius:0 0 10px 10px;">
    <!-- Не подписанные -->
    <div class="tab-pane fade @(Model.ActiveTab == "pending" ? "show active" : "")" id="tab-pending">
        @await Html.PartialAsync("_DocumentsTable", new ViewDataDictionary(ViewData)
        {
            { "Docs", Model.PendingDocs },
            { "TabId", "pending" },
            { "PageParam", "pendingPage" },
            { "ShowActions", true },
            { "CertificateMode", Model.AppCertificateMode },
            { "SignedPage", Model.SignedPage },
            { "DeclinedPage", Model.DeclinedPage }
        })
    </div>

    <!-- Подписанные -->
    <div class="tab-pane fade @(Model.ActiveTab == "signed" ? "show active" : "")" id="tab-signed">
        @await Html.PartialAsync("_DocumentsTable", new ViewDataDictionary(ViewData)
        {
            { "Docs", Model.SignedDocs },
            { "TabId", "signed" },
            { "PageParam", "signedPage" },
            { "ShowActions", false },
            { "CertificateMode", Model.AppCertificateMode },
            { "PendingPage", Model.PendingPage },
            { "DeclinedPage", Model.DeclinedPage }
        })
    </div>

    <!-- Отклонённые -->
    <div class="tab-pane fade @(Model.ActiveTab == "declined" ? "show active" : "")" id="tab-declined">
        @await Html.PartialAsync("_DocumentsTable", new ViewDataDictionary(ViewData)
        {
            { "Docs", Model.DeclinedDocs },
            { "TabId", "declined" },
            { "PageParam", "declinedPage" },
            { "ShowActions", false },
            { "CertificateMode", Model.AppCertificateMode },
            { "PendingPage", Model.PendingPage },
            { "SignedPage", Model.SignedPage }
        })
    </div>
</div>

<!-- Reject modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
        <div class="modal-content" style="border-radius:12px;border:none;box-shadow:0 20px 60px rgba(0,0,0,0.18);">
            <div class="modal-header" style="border-bottom:1px solid #f3f4f6;padding:1.25rem 1.5rem 1rem;">
                <div class="d-flex align-items-center gap-3">
                    <div style="width:40px;height:40px;background:#fee2e2;border-radius:10px;display:flex;align-items:center;justify-content:center;">
                        <i class="bi bi-x-circle" style="color:#dc2626;font-size:1.1rem;"></i>
                    </div>
                    <h5 class="modal-title mb-0" style="font-size:0.95rem;font-weight:700;color:#111827;">Отказ от подписи</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding:1.25rem 1.5rem;">
                <p style="font-size:0.875rem;color:#374151;margin:0;">
                    Вы уверены, что хотите отказаться от подписи документа
                    <strong id="rejectDocTitle" style="color:#111827;"></strong>?
                </p>
                <div class="mt-3 p-3" style="background:#fffbeb;border:1px solid #fde68a;border-radius:8px;">
                    <p class="mb-0" style="font-size:0.8rem;color:#92400e;">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        Это действие нельзя отменить. Документ перейдёт в статус «Отклонён».
                    </p>
                </div>
            </div>
            <div class="modal-footer" style="border-top:1px solid #f3f4f6;padding:1rem 1.5rem;gap:0.5rem;">
                <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Отмена</button>
                <form id="rejectForm" method="post">
                    <input type="hidden" name="id" id="rejectDocId" />
                    @Html.AntiForgeryToken()
                    <button type="submit" asp-page-handler="Reject"
                            class="btn btn-sm btn-danger" style="border-radius:7px;">
                        <i class="bi bi-x-circle me-1"></i>Отказаться
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Local sign modal (CryptoPro Browser Plugin) -->
<div class="modal fade" id="signLocalModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:500px;">
        <div class="modal-content" style="border-radius:12px;border:none;box-shadow:0 20px 60px rgba(0,0,0,0.18);">
            <div class="modal-header" style="border-bottom:1px solid #f3f4f6;padding:1.25rem 1.5rem 1rem;">
                <div class="d-flex align-items-center gap-3">
                    <div style="width:40px;height:40px;background:#d1fae5;border-radius:10px;display:flex;align-items:center;justify-content:center;">
                        <i class="bi bi-pen" style="color:#059669;font-size:1.1rem;"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0" style="font-size:0.95rem;font-weight:700;color:#111827;">Подписание документа</h5>
                        <p class="mb-0" id="signLocalDocTitle" style="font-size:0.78rem;color:#9ca3af;"></p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding:1.25rem 1.5rem;">

                <!-- Ошибка плагина -->
                <div id="pluginError" style="display:none;"
                     class="alert alert-danger d-flex gap-2 align-items-start py-2 mb-3">
                    <i class="bi bi-exclamation-triangle-fill flex-shrink-0 mt-1"></i>
                    <div style="font-size:0.83rem;">
                        <strong>КриптоПро Browser Plugin не обнаружен.</strong><br/>
                        Установите
                        <a href="https://www.cryptopro.ru/products/cades/plugin" target="_blank">КриптоПро ЭЦП Browser Plug-in</a>
                        и обновите страницу.
                    </div>
                </div>

                <!-- Загрузка сертификатов -->
                <div id="certsLoading" class="text-center py-3">
                    <div class="spinner-border spinner-border-sm text-primary me-2"></div>
                    <span style="font-size:0.85rem;color:#6b7280;">Загрузка сертификатов...</span>
                </div>

                <!-- Список сертификатов -->
                <div id="certsSection" style="display:none;">
                    <label class="form-label" style="font-size:0.82rem;font-weight:600;color:#374151;">
                        Сертификат для подписи
                    </label>
                    <select id="certSelect" class="form-select form-select-sm mb-3"></select>

                    <div id="certInfo" style="font-size:0.78rem;color:#6b7280;background:#f8f9fb;
                         border:1px solid #e8ecf0;border-radius:8px;padding:0.65rem 0.9rem;margin-bottom:1rem;display:none;">
                        <div><strong>Кому:</strong> <span id="certSubject"></span></div>
                        <div><strong>Действителен до:</strong> <span id="certValidTo"></span></div>
                    </div>

                    <!-- Прогресс подписания -->
                    <div id="signingProgress" style="display:none;" class="mb-3">
                        <div class="d-flex align-items-center gap-2 mb-1" style="font-size:0.82rem;color:#374151;">
                            <div class="spinner-border spinner-border-sm text-success"></div>
                            <span id="signingProgressText">Загрузка документа...</span>
                        </div>
                        <div class="progress" style="height:4px;">
                            <div id="signingProgressBar" class="progress-bar bg-success" style="width:0%;transition:width 0.3s;"></div>
                        </div>
                    </div>

                    <!-- Результат -->
                    <div id="signingResult" style="display:none;" class="alert py-2 mb-3" style="font-size:0.83rem;"></div>

                    <button id="btnSign" type="button"
                            class="btn w-100"
                            style="background:#059669;color:#fff;border:none;border-radius:7px;padding:0.6rem;font-weight:600;font-size:0.9rem;">
                        <i class="bi bi-pen me-1"></i>Подписать
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@* Скрытое поле для CSRF токена — читается JS *@
@Html.AntiForgeryToken()

@section Scripts {
    @* CryptoPro Browser Plugin API — требует установленного КриптоПро ЭЦП Browser Plug-in *@
    <script src="https://www.cryptopro.ru/sites/default/files/products/cades/cadesplugin_api.js"
            onerror="window._cadesLoadFailed = true"></script>

    <script>
        // ── Вкладки ────────────────────────────────────────────────────────
        document.querySelectorAll('[data-bs-toggle="tab"]').forEach(btn => {
            btn.addEventListener('shown.bs.tab', function () {
                const tabId = btn.dataset.bsTarget.replace('#tab-', '');
                const url = new URL(window.location.href);
                url.searchParams.set('tab', tabId);
                history.replaceState(null, '', url);
            });
        });

        // ── Reject modal ───────────────────────────────────────────────────
        const rejectModal = document.getElementById('rejectModal');
        rejectModal.addEventListener('show.bs.modal', function (e) {
            const btn = e.relatedTarget;
            document.getElementById('rejectDocId').value = btn.dataset.docId;
            document.getElementById('rejectDocTitle').textContent = btn.dataset.docTitle;
            document.getElementById('rejectForm').action = '?handler=Reject';
        });

        // ── Local sign modal (CryptoPro) ───────────────────────────────────
        let _currentDocId = null;

        const signLocalModalEl = document.getElementById('signLocalModal');
        signLocalModalEl.addEventListener('show.bs.modal', async function (e) {
            const btn = e.relatedTarget;
            _currentDocId = btn.dataset.docId;
            document.getElementById('signLocalDocTitle').textContent = btn.dataset.docTitle;
            resetSignModal();
            await loadCertificates();
        });

        signLocalModalEl.addEventListener('hidden.bs.modal', function () {
            // Если подписание прошло успешно — перезагружаем страницу
            if (signLocalModalEl.dataset.reloadOnClose === 'true') {
                window.location.reload();
            }
        });

        document.getElementById('certSelect').addEventListener('change', showCertInfo);
        document.getElementById('btnSign').addEventListener('click', performSigning);

        function resetSignModal() {
            signLocalModalEl.dataset.reloadOnClose = 'false';
            show('certsLoading');
            hide('certsSection');
            hide('pluginError');
            hide('signingProgress');
            hide('signingResult');
            document.getElementById('certSelect').innerHTML = '';
            document.getElementById('btnSign').disabled = false;
            document.getElementById('btnSign').innerHTML = '<i class="bi bi-pen me-1"></i>Подписать';
        }

        /// Ожидает готовности native host расширения. Без этого CreateObjectAsync может падать,
        /// а catch ниже ошибочно показывал «плагин не установлен».
        async function waitForCadesReady() {
            if (window._cadesLoadFailed || typeof window.cadesplugin === 'undefined') {
                throw new Error('CadesPluginMissing');
            }
            const cp = window.cadesplugin;
            if (cp && typeof cp.then === 'function') {
                try {
                    await cp;
                } catch (e) {
                    const msg = typeof e === 'string' ? e : (e && e.message) ? e.message : String(e);
                    throw new Error(msg || 'CadesPluginMissing');
                }
            }
        }

        function isLikelyPluginUnavailable(err) {
            const raw = (err && err.message) ? err.message : String(err);
            return raw === 'CadesPluginMissing'
                || /недоступен|истекло время ожидания|CadesPluginMissing/i.test(raw);
        }

        async function loadCertificates() {
            if (window._cadesLoadFailed || typeof window.cadesplugin === 'undefined') {
                show('pluginError');
                hide('certsLoading');
                return;
            }
            try {
                await waitForCadesReady();
                const certs = await getCertificatesFromStore();
                hide('certsLoading');
                hide('pluginError');
                if (certs.length === 0) {
                    showResult('alert-warning', '<i class="bi bi-exclamation-circle me-1"></i>Сертификаты не найдены в хранилище "Личные".');
                    show('certsSection');
                    document.getElementById('btnSign').disabled = true;
                    return;
                }
                const sel = document.getElementById('certSelect');
                certs.forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c.thumbprint;
                    opt.textContent = c.displayName;
                    opt.dataset.subject = c.subjectName;
                    opt.dataset.validTo = c.validTo;
                    sel.appendChild(opt);
                });
                showCertInfo();
                show('certsSection');
            } catch (err) {
                hide('certsLoading');
                console.error('cadesplugin error:', err);
                if (isLikelyPluginUnavailable(err)) {
                    show('pluginError');
                } else {
                    showResult('alert-danger', `<i class="bi bi-exclamation-circle-fill me-1"></i>${escapeHtml((err && err.message) ? err.message : String(err))}`);
                    show('certsSection');
                    document.getElementById('btnSign').disabled = true;
                }
            }
        }

        function showCertInfo() {
            const sel = document.getElementById('certSelect');
            const opt = sel.options[sel.selectedIndex];
            if (!opt) return;
            document.getElementById('certSubject').textContent = parseCN(opt.dataset.subject);
            document.getElementById('certValidTo').textContent = formatDate(opt.dataset.validTo);
            show('certInfo');
        }

        async function performSigning() {
            const thumbprint = document.getElementById('certSelect').value;
            if (!thumbprint) return;

            const btn = document.getElementById('btnSign');
            btn.disabled = true;
            hide('signingResult');
            show('signingProgress');
            setProgress(10, 'Загрузка документа...');

            try {
                // 1. Получаем байты документа через Razor Pages (cookie auth)
                const docResp = await fetch(`/Sign?handler=DocumentBytes&id=${_currentDocId}`);
                const docData = await docResp.json();
                if (!docData.success) throw new Error(docData.message ?? 'Ошибка загрузки документа');
                setProgress(40, 'Подписание...');

                // 2. Подписываем через CryptoPro Browser Plugin
                await waitForCadesReady();
                const signatureBase64 = await signWithCryptoPro(docData.base64, thumbprint);
                setProgress(75, 'Отправка подписи на сервер...');

                // 3. Отправляем подпись через Razor Pages AJAX
                const token = document.querySelector('[name="__RequestVerificationToken"]').value;
                const submitResp = await fetch('/Sign?handler=SignLocal', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ id: parseInt(_currentDocId), signatureBase64 })
                });
                const submitData = await submitResp.json();
                if (!submitData.success) throw new Error(submitData.message ?? 'Ошибка при сохранении подписи');

                setProgress(100, 'Готово');
                hide('signingProgress');
                showResult('alert-success', '<i class="bi bi-check-circle-fill me-1"></i>Документ успешно подписан!');
                btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Подписано';
                signLocalModalEl.dataset.reloadOnClose = 'true';
                setTimeout(() => bootstrap.Modal.getInstance(signLocalModalEl)?.hide(), 1500);

            } catch (err) {
                hide('signingProgress');
                showResult('alert-danger', `<i class="bi bi-exclamation-circle-fill me-1"></i>${escapeHtml(err.message ?? String(err))}`);
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i>Повторить';
            }
        }

        // ── CryptoPro helpers ──────────────────────────────────────────────

        function getCertificatesFromStore() {
            return new Promise((resolve, reject) => {
                cadesplugin.async_spawn(function* () {
                    try {
                        const oStore = yield cadesplugin.CreateObjectAsync('CAdESCOM.Store');
                        yield oStore.Open(
                            cadesplugin.CADESCOM_CURRENT_USER_STORE,
                            cadesplugin.CAPICOM_MY_STORE,
                            cadesplugin.CAPICOM_STORE_OPEN_MAXIMUM_ALLOWED
                        );
                        const oCerts = yield oStore.Certificates;
                        const count  = yield oCerts.Count;
                        const result = [];
                        for (let i = 1; i <= count; i++) {
                            const cert       = yield oCerts.Item(i);
                            const thumbprint = yield cert.Thumbprint;
                            const subject    = yield cert.SubjectName;
                            const validTo    = yield cert.ValidToDate;
                            result.push({
                                thumbprint,
                                subjectName: subject,
                                validTo: new Date(validTo).toLocaleDateString('ru-RU'),
                                displayName: `${parseCN(subject)} (до ${new Date(validTo).toLocaleDateString('ru-RU')})`
                            });
                        }
                        yield oStore.Close();
                        resolve(result);
                    } catch (e) { reject(e); }
                });
            });
        }

        function signWithCryptoPro(base64Content, thumbprint) {
            return new Promise((resolve, reject) => {
                cadesplugin.async_spawn(function* () {
                    try {
                        const oStore = yield cadesplugin.CreateObjectAsync('CAdESCOM.Store');
                        yield oStore.Open(
                            cadesplugin.CADESCOM_CURRENT_USER_STORE,
                            cadesplugin.CAPICOM_MY_STORE,
                            cadesplugin.CAPICOM_STORE_OPEN_MAXIMUM_ALLOWED
                        );
                        const oCerts = yield oStore.Certificates;
                        const found  = yield oCerts.Find(
                            cadesplugin.CAPICOM_CERTIFICATE_FIND_SHA1_HASH, thumbprint
                        );
                        const foundCount = yield found.Count;
                        if (foundCount === 0) throw new Error('Сертификат не найден в хранилище');

                        const oCert = yield found.Item(1);

                        const oSigner = yield cadesplugin.CreateObjectAsync('CAdESCOM.CPSigner');
                        yield oSigner.propset_Certificate(oCert);
                        yield oSigner.propset_Options(
                            cadesplugin.CAPICOM_CERTIFICATE_INCLUDE_CHAIN_EXCEPT_ROOT
                        );

                        const oSignedData = yield cadesplugin.CreateObjectAsync('CAdESCOM.CadesSignedData');
                        yield oSignedData.propset_ContentEncoding(cadesplugin.CADESCOM_BASE64_TO_BINARY);
                        yield oSignedData.propset_Content(base64Content);

                        // CADESCOM_CADES_BES (1) — CAdES-BES, detached=true
                        const sig = yield oSignedData.SignCades(oSigner, cadesplugin.CADESCOM_CADES_BES, true);

                        yield oStore.Close();
                        resolve(sig);
                    } catch (e) { reject(e); }
                });
            });
        }

        // ── UI helpers ─────────────────────────────────────────────────────

        function show(id) { document.getElementById(id).style.display = ''; }
        function hide(id) { document.getElementById(id).style.display = 'none'; }

        function setProgress(pct, text) {
            document.getElementById('signingProgressBar').style.width = pct + '%';
            document.getElementById('signingProgressText').textContent = text;
        }

        function showResult(cls, html) {
            const el = document.getElementById('signingResult');
            el.className = `alert ${cls} py-2 mb-3`;
            el.innerHTML = html;
            el.style.display = '';
        }

        function parseCN(subjectName) {
            const m = subjectName && subjectName.match(/CN=([^,]+)/i);
            return m ? m[1].trim() : subjectName;
        }

        function formatDate(d) {
            return d ? new Date(d).toLocaleDateString('ru-RU') : '—';
        }

        function escapeHtml(str) {
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');
        }
    </script>
}
