@page
@model SignerApp.Pages.Account.VerifyModel
@{
    Layout = null;
    ViewData["Title"] = "Подтверждение";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Подтверждение — Подписант</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(135deg, #1a1f2e 0%, #2d3654 100%);
            min-height: 100vh;
            display: flex; align-items: center; justify-content: center;
            font-family: 'Segoe UI', system-ui, sans-serif;
        }
        .login-card { width: 100%; max-width: 400px; background: #fff; border-radius: 16px; box-shadow: 0 20px 60px rgba(0,0,0,0.35); overflow: hidden; }
        .login-header { background: linear-gradient(135deg, #1a1f2e, #2d3654); padding: 2rem 2rem 1.5rem; text-align: center; }
        .login-header .icon-wrapper { width: 56px; height: 56px; background: rgba(79,142,247,0.2); border-radius: 14px; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; border: 1px solid rgba(79,142,247,0.3); }
        .login-header h1 { color: #fff; font-size: 1.25rem; font-weight: 700; margin: 0; }
        .login-header p { color: rgba(255,255,255,0.55); font-size: 0.8rem; margin: 0.25rem 0 0; }
        .login-body { padding: 2rem; }
        .form-label { font-size: 0.82rem; font-weight: 600; color: #374151; margin-bottom: 0.4rem; }
        .form-control { border-radius: 8px; border: 1.5px solid #e5e7eb; padding: 0.6rem 0.85rem; font-size: 0.9rem; transition: border-color 0.15s; }
        .form-control:focus { border-color: #4f8ef7; box-shadow: 0 0 0 3px rgba(79,142,247,0.12); }
        .code-input {
            letter-spacing: 0.4em;
            text-align: center;
            font-size: 1.4rem;
            font-weight: 700;
            font-variant-numeric: tabular-nums;
        }
        .btn-login { background: #4f8ef7; border: none; border-radius: 8px; padding: 0.7rem; font-size: 0.9rem; font-weight: 600; color: #fff; width: 100%; transition: background 0.15s; margin-top: 0.25rem; }
        .btn-login:hover { background: #3a7bd5; color: #fff; }
        .alert { border-radius: 8px; font-size: 0.85rem; padding: 0.65rem 1rem; }
        .step-indicator { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.25rem; }
        .step-dot { width: 8px; height: 8px; border-radius: 50%; background: #e5e7eb; }
        .step-dot.active { background: #4f8ef7; }
        .step-text { font-size: 0.78rem; color: #9ca3af; }
        .step-text span { color: #374151; font-weight: 600; }
        .code-hint { background: #f0f7ff; border: 1px solid #bfdbfe; border-radius: 8px; padding: 0.65rem 1rem; font-size: 0.82rem; color: #1e40af; margin-bottom: 1.25rem; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-header">
            <div class="icon-wrapper">
                <i class="bi bi-shield-check" style="font-size: 1.5rem; color: #4f8ef7;"></i>
            </div>
            <h1>Подтверждение входа</h1>
            <p>Проверьте электронную почту</p>
        </div>
        <div class="login-body">
            <div class="step-indicator">
                <div class="step-dot"></div>
                <div class="step-dot active"></div>
                <div class="step-text">Шаг <span>2 из 2</span> — Введите код</div>
            </div>

            <div class="code-hint">
                <i class="bi bi-envelope me-1"></i>
                Код отправлен для: <strong>@Model.LoginDisplay</strong>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    @Model.ErrorMessage
                </div>
            }

            <form method="post">
                <input type="hidden" asp-for="LoginInput" />
                <div class="mb-3">
                    <label asp-for="Code" class="form-label">Код подтверждения</label>
                    <input asp-for="Code" class="form-control code-input"
                           placeholder="——————" maxlength="6"
                           autocomplete="one-time-code" autofocus
                           inputmode="numeric" pattern="[0-9]*" />
                    
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-login">
                    <i class="bi bi-check-circle me-2"></i>Подтвердить
                </button>
            </form>

            <p class="text-center mt-3 mb-0">
                <a href="/Account/Login" style="font-size: 0.78rem; color: #9ca3af;">
                    <i class="bi bi-arrow-left me-1"></i>Вернуться к вводу логина
                </a>
            </p>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
