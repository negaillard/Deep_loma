<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Подписант</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        :root {
            --sidebar-width: 220px;
            --brand-color: #4f8ef7;
        }

        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background: #f8f9fb;
            min-height: 100vh;
        }

        /* Sidebar */
        .sidebar {
            position: fixed;
            top: 0; left: 0;
            width: var(--sidebar-width);
            height: 100vh;
            background: #1a1f2e;
            display: flex;
            flex-direction: column;
            z-index: 100;
        }

        .sidebar-brand {
            padding: 1.25rem 1.25rem 1rem;
            border-bottom: 1px solid rgba(255,255,255,0.07);
        }

        .sidebar-brand .brand-icon {
            width: 36px; height: 36px;
            background: rgba(79,142,247,0.18);
            border-radius: 9px;
            display: flex; align-items: center; justify-content: center;
            border: 1px solid rgba(79,142,247,0.3);
            flex-shrink: 0;
        }

        .sidebar-brand .brand-text {
            font-size: 0.88rem;
            font-weight: 700;
            color: #fff;
            line-height: 1.2;
        }

        .sidebar-brand .brand-sub {
            font-size: 0.7rem;
            color: rgba(255,255,255,0.4);
        }

        .sidebar-nav {
            flex: 1;
            padding: 0.75rem 0;
            overflow-y: auto;
        }

        .sidebar-nav .nav-label {
            font-size: 0.65rem;
            font-weight: 700;
            color: rgba(255,255,255,0.3);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            padding: 0.5rem 1.25rem 0.25rem;
        }

        .sidebar-nav a {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            padding: 0.55rem 1.25rem;
            color: rgba(255,255,255,0.6);
            text-decoration: none;
            font-size: 0.85rem;
            border-radius: 0;
            transition: background 0.15s, color 0.15s;
        }

        .sidebar-nav a:hover,
        .sidebar-nav a.active {
            background: rgba(79,142,247,0.12);
            color: #fff;
        }

        .sidebar-nav a.active {
            border-left: 3px solid var(--brand-color);
        }

        .sidebar-footer {
            padding: 1rem 1.25rem;
            border-top: 1px solid rgba(255,255,255,0.07);
        }

        .user-info {
            font-size: 0.78rem;
            color: rgba(255,255,255,0.5);
            margin-bottom: 0.6rem;
        }

        .user-info strong {
            display: block;
            color: rgba(255,255,255,0.85);
            font-size: 0.82rem;
        }

        /* Main content */
        .main-wrapper {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .topbar {
            background: #fff;
            border-bottom: 1px solid #e8ecf0;
            padding: 0.75rem 1.75rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .topbar h1 {
            font-size: 1.05rem;
            font-weight: 700;
            color: #111827;
            margin: 0;
        }

        .page-content {
            flex: 1;
            padding: 1.5rem 1.75rem;
        }

        /* Cards */
        .card {
            border: 1px solid #e8ecf0;
            border-radius: 10px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.04);
        }

        .card-header {
            background: #fafafa;
            border-bottom: 1px solid #e8ecf0;
            padding: 0.75rem 1.25rem;
            font-weight: 600;
            font-size: 0.88rem;
            color: #374151;
            border-radius: 10px 10px 0 0 !important;
        }

        /* Badges */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            padding: 0.2rem 0.6rem;
            border-radius: 20px;
            font-size: 0.72rem;
            font-weight: 600;
        }

        .badge-not-signed { background: #fff7ed; color: #c2410c; }
        .badge-pending    { background: #eff6ff; color: #1d4ed8; }
        .badge-signed     { background: #d1fae5; color: #065f46; }
        .badge-declined   { background: #fee2e2; color: #991b1b; }

        /* Table */
        .table th {
            font-size: 0.78rem;
            font-weight: 600;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            border-bottom: 2px solid #e8ecf0;
        }

        .table td {
            font-size: 0.84rem;
            color: #374151;
            vertical-align: middle;
        }

        /* Pagination */
        .pagination-bar {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.75rem 1.25rem;
            border-top: 1px solid #e8ecf0;
        }

        .page-info {
            font-size: 0.78rem;
            color: #9ca3af;
            margin-left: auto;
        }

        @@media (max-width: 768px) {
            .sidebar { display: none; }
            .main-wrapper { margin-left: 0; }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav class="sidebar">
        <div class="sidebar-brand d-flex align-items-center gap-2">
            <div class="brand-icon">
                <i class="bi bi-pen" style="color:#4f8ef7; font-size:1rem;"></i>
            </div>
            <div>
                <div class="brand-text">Подписант</div>
                <div class="brand-sub">Электронная подпись</div>
            </div>
        </div>

        <div class="sidebar-nav">
            <div class="nav-label">Документы</div>
            <a href="/Documents/Index" class="@(ViewData["ActivePage"]?.ToString() == "Documents" ? "active" : "")">
                <i class="bi bi-file-earmark-text"></i>На подписание
            </a>
        </div>

        <div class="sidebar-footer">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="user-info">
                    <strong>@User.Identity.Name</strong>
                    Подписант
                </div>
                <form method="post" action="/Account/Logout">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            style="background:rgba(239,68,68,0.12);color:#ef4444;border:none;border-radius:7px;padding:0.4rem 0.85rem;font-size:0.8rem;font-weight:600;width:100%;cursor:pointer;">
                        <i class="bi bi-box-arrow-left me-1"></i>Выйти
                    </button>
                </form>
            }
        </div>
    </nav>

    <div class="main-wrapper">
        <div class="topbar">
            <h1>@ViewData["Title"]</h1>
            @await RenderSectionAsync("TopbarRight", required: false)
        </div>
        <div class="page-content">
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
