@startuml "Диаграмма компонентов — Система электронного документооборота"

skinparam componentStyle uml2
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #444444
skinparam ArrowFontSize 10
skinparam ComponentBackgroundColor #EEF4FF
skinparam ComponentBorderColor #4A6FA5
skinparam ComponentFontSize 12
skinparam PackageBackgroundColor #F5F5F5
skinparam PackageBorderColor #AAAAAA
skinparam PackageFontSize 12
skinparam DatabaseBackgroundColor #FFF8E1
skinparam DatabaseBorderColor #F9A825
skinparam QueueBackgroundColor #E8F5E9
skinparam QueueBorderColor #388E3C
skinparam InterfaceBackgroundColor #FFFDE7
skinparam InterfaceBorderColor #F9A825
skinparam noteFontSize 10
skinparam NoteBackgroundColor #FFFFF0

title Диаграмма компонентов\nСистема электронного документооборота с ЭЦП

top to bottom direction

' ═══════════════════════════════════════════════════════════
'  1. ВЕБ-КЛИЕНТЫ
' ═══════════════════════════════════════════════════════════
together {
  component "DocumentApp\n(Razor Pages, :7154)" as DocumentApp <<component>>
  component "AdminApp\n(Razor Pages)" as AdminApp <<component>>
}

' ═══════════════════════════════════════════════════════════
'  2. API
' ═══════════════════════════════════════════════════════════
() "REST API\n(:7225)" as IRestAPI
component "API\n(ASP.NET Core Web API, :7225)" as API <<component>>

API -- IRestAPI
DocumentApp --( IRestAPI : HTTP/HTTPS
AdminApp    --( IRestAPI : HTTP/HTTPS

' ═══════════════════════════════════════════════════════════
'  3. БИБЛИОТЕКИ БИЗНЕС-ЛОГИКИ
' ═══════════════════════════════════════════════════════════
together {
  component "Logic\n(Бизнес-логика)" as Logic <<component>>
  component "Auth\n(Аутентификация)" as AuthLib <<component>>
  component "Storage\n(EF Core)" as Storage <<component>>
  component "FileStorage\n(Локальные файлы)" as FileStorageLib <<component>>
}

() "IDocumentLogic\nICertificateLogic" as ILogicIface
() "ISessionService\nICodeVerification" as IAuthIface
() "IDocumentStorage\nIUserStorage\n..." as IStorageIface
() "IFileStorage" as IFileIface
() "IAntivirusService" as IAntivirusIface

Logic          -- ILogicIface
AuthLib        -- IAuthIface
Storage        -- IStorageIface
FileStorageLib -- IFileIface

API --( ILogicIface
API --( IAuthIface
API --( IFileIface
API --( IAntivirusIface

Logic   --( IStorageIface
Logic   --( IFileIface
AuthLib --( IStorageIface

' ═══════════════════════════════════════════════════════════
'  4. РЕАЛИЗАЦИИ ПОДПИСАНИЯ
' ═══════════════════════════════════════════════════════════
() "IDocumentSigner" as IDocSigner

together {
  component "InternalDocumentSigner\n(RSA-2048 / PKCS#7)" as InternalSigner <<component>>
  component "CryptoProDocumentSigner\n(ГОСТ Р 34.10-2012)" as CryptoSigner <<component>>
}

InternalSigner -- IDocSigner
CryptoSigner   -- IDocSigner

' ═══════════════════════════════════════════════════════════
'  5. ОБЩИЕ КОНТРАКТЫ СООБЩЕНИЙ
' ═══════════════════════════════════════════════════════════
component "MessageContracts\n(SigningRequestMessage\nNotificationMessage)" as MsgContracts <<component>>

' ═══════════════════════════════════════════════════════════
'  6. ФОНОВЫЕ СЕРВИСЫ
' ═══════════════════════════════════════════════════════════
together {
  component "SigningService\n(.NET Worker)" as SigningService <<component>>
  component "NotificationService\n(.NET Worker)" as NotificationService <<component>>
}

SigningService      --( IDocSigner
SigningService      ..> MsgContracts : «use»
NotificationService ..> MsgContracts : «use»
API                 ..> MsgContracts : «use»

' ═══════════════════════════════════════════════════════════
'  7. ВНЕШНИЕ СИСТЕМЫ
' ═══════════════════════════════════════════════════════════
package "Внешние системы" {
  together {
    database "SQL Server\n(DCP @ SQLEXPRESS)" as SQLServer
    database "Redis\n(localhost:6379)" as Redis
    queue    "RabbitMQ\n(localhost:5672)" as RabbitMQ
  }
  together {
    [ClamAV\n(localhost:3310)] as ClamAV
    [SMTP Yandex\n(smtp.yandex.ru:465)] as SMTP
    [Файловая система\nC:\\CompanyDocs] as FileSystem
    [КриптоПро CSP\n(Windows Cert Store)] as CryptoPro
  }
}

' ═══════════════════════════════════════════════════════════
'  СВЯЗИ С ВНЕШНИМИ СИСТЕМАМИ
' ═══════════════════════════════════════════════════════════
Storage        --> SQLServer  : EF Core
AuthLib        --> Redis      : StackExchange.Redis
FileStorageLib --> FileSystem : System.IO

API            --> ClamAV     : nClam
API            --> RabbitMQ   : MassTransit Publish\nSigningRequestMessage

SigningService --> SQLServer  : EF Core
SigningService --> FileSystem : System.IO
SigningService --> RabbitMQ   : MassTransit Consume\n+ Publish NotificationMessage

CryptoSigner   --> CryptoPro  : CryptoPro.Security\n(External mode)

NotificationService --> RabbitMQ  : MassTransit Consume\nNotificationMessage
NotificationService --> SQLServer : EF Core
NotificationService --> SMTP      : MailKit / MimeKit

@enduml
