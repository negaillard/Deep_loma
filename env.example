# Скопируйте в .env в корне репозитория (файл .env не коммитьте).
# Требуется для docker-compose.api-tests.yml и scripts/apply-docker-migrations.ps1

# Пароль учётной записи sa в SQL Server (см. требования Microsoft к сложности пароля).
MSSQL_SA_PASSWORD=ChangeMe_StrongPassw0rd!

# Переопределение засева начального администратора API (должны совпадать с переменными коллекции adminLogin / email).
API_TEST_ADMIN_LOGIN=admin@company.ru
API_TEST_ADMIN_EMAIL=admin@company.ru
API_TEST_ADMIN_FULLNAME=Тестовый администратор

# Опционально: переопределить тестовый код (должен совпадать с Auth__TestBypassCode в compose, по умолчанию 123456).
# API_TEST_ADMIN_LOGIN_CODE=123456
# API_TEST_SIGNER_LOGIN_CODE=123456
